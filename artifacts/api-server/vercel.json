{
  "buildCommand": "pnpm --filter @workspace/api-server run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "artifacts/api-server/api/index.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://kairo-trade-agent.vercel.app" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization,Content-Type" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/artifacts/api-server/api/index" }
  ]
}
