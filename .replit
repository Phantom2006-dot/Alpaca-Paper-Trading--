modules = ["nodejs-20", "web", "bash", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
builds = ["artifacts/api-server"]

[workflows]

[Agent]
stack = "PNPM_WORKSPACE"
command = "pnpm run typecheck"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
