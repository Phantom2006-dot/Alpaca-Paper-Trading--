{
  "buildCommand": "pnpm --filter @workspace/api-server run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "outputDirectory": "artifacts/api-server/dist"
}
